# Render dashboard PostgreSQL connection URL. Never commit the real URL.
# Local: External URL with sslmode=require. Render service: Internal URL.
DATABASE_URL=
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 아래 변수는 기능 구현 시 연결한다. 현재 공통 기반은 DATABASE_URL만 사용한다.
# 공공데이터포털에서 발급한 일반 인증키. API 요청 연결은 수집 기능에서 구현한다.
QNET_SERVICE_KEY=
# LLM 모델 제공자를 정한 뒤 필요한 변수만 사용한다.
OPENAI_API_KEY=
# Google 인증 담당자가 사용할 서버 설정. 실제 값은 담당자에게 별도 전달한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
