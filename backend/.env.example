# Render dashboard PostgreSQL connection URL. Never commit the real URL.
# Local: External URL with sslmode=require. Render service: Internal URL.
DATABASE_URL=
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 공공데이터포털에서 활용승인된 큐넷 API의 공통 인증키. 실제 키는 커밋하지 않는다.
# Encoding / Decoding 모두 허용하며 Encoding 키는 코드에서 한 번 디코딩한다.
QNET_SERVICE_KEY=

# 공식 직무 자료의 LLM 검토용. 실제 키는 로컬 .env에만 입력한다.
OPENAI_API_KEY=

# Google Calendar 전용 OAuth 웹 클라이언트 값. 실제 값은 backend/.env 또는 배포 환경변수에만 둔다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud 콘솔에 등록한 프론트엔드 Calendar 콜백 주소와 정확히 일치해야 한다.
GOOGLE_REDIRECT_URI=

# Google Calendar 갱신 토큰을 암호화하는 Fernet 키. Client Secret과 별도로 생성·보관한다.
# 생성: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 브라우저 CORS 허용 Origin만 쉼표로 구분한다. 경로나 끝 슬래시를 넣지 않는다.
# 예: http://localhost:8501,https://example.com
AUTH_ALLOWED_ORIGINS=
# HTTPS 배포 환경에서는 true, 로컬 HTTP 개발에서만 false로 설정한다.
AUTH_COOKIE_SECURE=true

